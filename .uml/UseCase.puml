@startuml
'https://plantuml.com/use-case-diagram

actor "사용자" as user

package "회원" as member {
  usecase (생성) as memberCreate
  usecase (수정) as memberModify
}

package "인증" as auth {
  usecase (OAuth 로그인) as oauthLogin
  usecase (토큰 발급) as issueAuthToken
}

package "OAuth 서버" as oauth {
  usecase (인가 코드 발급) as issueOAuthCode
  usecase (OAuth 토큰 발급) as issueOAuthToken
}

user -> oauthLogin
oauthLogin --> issueOAuthCode
issueOAuthCode -> issueOAuthCode: SNS 로그인(사용자와 소통)
issueOAuthCode --> user: 인가 코드 응답
user --> issueAuthToken
issueAuthToken --> issueOAuthToken
issueAuthToken --> memberCreate
issueAuthToken -> memberModify

@enduml